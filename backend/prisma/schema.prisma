generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id       String @id @default(uuid())
  googleId String @unique
  email    String @unique
  name     String
  avatar   String?

  campaigns Campaign[]
  senders   Sender[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([googleId])
  @@index([email])
}

model Sender {
  id               String @id @default(uuid())
  userId           String

  email            String

  etherealUser     String
  etherealPassword String

  hourlyLimit Int @default(200)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
}

model Campaign {
  id          String         @id @default(uuid())
  userId      String

  subject     String
  body        String

  startTime   DateTime
  delayMs     Int            @default(2000)
  hourlyLimit Int            @default(200)

  status CampaignStatus @default(ACTIVE)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startTime])
}

model Email {
  id         String @id @default(uuid())
  campaignId String
  senderId   String

  recipient String

  subject String
  body    String

  scheduledAt DateTime
  sentAt      DateTime?

  status EmailStatus @default(SCHEDULED)

  attempts Int    @default(0)
  error    String?

  sequenceNumber Int

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([senderId])
  @@index([status])
  @@index([scheduledAt])
  @@index([campaignId, sequenceNumber])
}
